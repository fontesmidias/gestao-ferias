DATABASE_URL="postgresql://admin:adminpassword@localhost:5432/gestaoferias?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=change-me-in-production-min-32-chars
PORT=3000
NODE_ENV=development

# MASTERKEY — Acesso emergencial (mínimo 32 caracteres, deixar vazio para desabilitar)
MASTER_KEY=

# AES-256-GCM master key para criptografia de bankData (LGPD)
# Gerar localmente: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Em produção: provisionar como Docker Secret no Swarm. NUNCA commitar valor real.
# Obrigatório para subir o backend (fail-fast no startup).
BANK_DATA_ENCRYPTION_KEY=
