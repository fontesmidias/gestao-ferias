DATABASE_URL="postgresql://admin:adminpassword@localhost:5432/gestaoferias?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=change-me-in-production-min-32-chars
PORT=3000
NODE_ENV=development

# MASTERKEY — Acesso emergencial (mínimo 32 caracteres, deixar vazio para desabilitar)
MASTER_KEY=

# AES-256-GCM master key para criptografia de bankData (LGPD)
# Gerar localmente: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Em produção: provisionar como Docker Secret no Swarm. NUNCA commitar valor real.
# Obrigatório para subir o backend (fail-fast no startup).
BANK_DATA_ENCRYPTION_KEY=

# Caminho do volume onde arquivos .xlsx de import ficam persistidos.
# Em produção: volume Docker `imports-data:/var/imports`.
# Em dev local: pode usar ./tmp/imports (sem volume Docker).
IMPORT_FILE_STORAGE_PATH=/var/imports

# Retenção do arquivo original (em dias). Após esse prazo o cleanup-cron
# remove o arquivo e zera storagePath/errorReportPath (ImportJob preservado).
IMPORT_RETENTION_DAYS=90

# BullMQ worker concurrency (jobs paralelos no worker dedicado).
IMPORT_WORKER_CONCURRENCY=2

# TTL do lock distribuído por tenant (em segundos). Deve ser > timeout
# de processamento (15min). Default 16min protege contra crash.
IMPORT_TENANT_LOCK_TTL_SEC=960

# Idle minutes antes de marcar job travado como TIMED_OUT.
IMPORT_JOB_TIMEOUT_MIN=15
