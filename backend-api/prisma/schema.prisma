// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  cnpj      String   @unique
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  responsible String?
  smtpHost  String?  @map("smtp_host")
  smtpPort  Int?     @map("smtp_port")
  smtpUser  String?  @map("smtp_user")
  smtpPass  String?  @map("smtp_pass")
  smtpFrom  String?  @map("smtp_from")

  lastLoginAt DateTime? @map("last_login_at")
  openaiKey    String?  @map("openai_key")
  anthropicKey String?  @map("anthropic_key")
  geminiKey    String?  @map("gemini_key")
  llmProvider  String?  @map("llm_provider")
  llmModel     String?  @map("llm_model")
  groqKey      String?  @map("groq_key")

  evoApiUrl       String?  @map("evo_api_url")
  evoApiKey       String?  @map("evo_api_key")
  evoInstanceName String?  @map("evo_instance_name")
  whatsappEnabled Boolean  @default(false) @map("whatsapp_enabled")

  zapSignToken    String?  @map("zapsign_token")

  // Story 7.2: Theming por tenant
  brandName          String?  @map("brand_name")
  brandPrimaryColor  String?  @map("brand_primary_color")
  brandSecondaryColor String? @map("brand_secondary_color")
  brandLogoUrl       String?  @map("brand_logo_url")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  employees          Employee[]
  auditLogs          AuditLog[]
  vacationRequests   VacationRequest[]
  signatures         Signature[]
  refreshTokens      RefreshToken[]
  webhooks           Webhook[]
  workplaces         Workplace[]
  workplacePositions WorkplacePosition[]
  workplaceAllocations WorkplaceAllocation[]
  coverageAssignments  CoverageAssignment[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String
  name         String?
  passwordHash String?  @map("password_hash")
  role         String   @default("USER") // SUPERADMIN, ADMIN, USER, AUDITOR
  isActive     Boolean  @default(true) @map("is_active")
  tenantId     String?  @map("tenant_id") @db.Uuid // nullable para SUPERADMIN
  passwordResetToken  String?   @unique @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  emailVerifiedAt     DateTime? @map("email_verified_at")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  employee      Employee?

  @@unique([email, tenantId])
  @@map("users")
}

model Employee {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  cpf           String
  registration  String?  @map("registration")
  birthDate     DateTime? @map("birth_date")
  position      String?  @default("Colaborador")
  employeeType  String   @default("EFETIVO") @map("employee_type") // EFETIVO, INTERMITENTE
  isFerista     Boolean  @default(false) @map("is_ferista")

  status        String   @default("ATIVO") // ATIVO, FERIAS, AFASTADO, INATIVO
  branch        String?  // Empresa/Filial
  department    String?  // Contrato / CC
  workplace     String?  // Posto de Serviço (texto legado, será deprecado)
  workplaceId   String?  @map("workplace_id") @db.Uuid
  shift         String?  // Jornada / Escala

  phone         String?
  salary        Decimal? @default(0) @db.Decimal(10, 2)
  hireDate      DateTime @map("hire_date")
  balanceOffset Int     @default(0) @map("balance_offset")
  userId        String?  @unique @map("user_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User?      @relation(fields: [userId], references: [id])
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  workplaceRef  Workplace? @relation(fields: [workplaceId], references: [id])
  requests      VacationRequest[]
  allocations   WorkplaceAllocation[]
  coveragesAsReplacement CoverageAssignment[] @relation("CoverageReplacement")

  @@unique([cpf, tenantId])
  @@map("employees")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  action       String   // e.g., "MANUAL_BALANCE_ADJUSTMENT"
  resourceId   String   @map("resource_id") @db.Uuid
  resourceType String   @map("resource_type") // e.g., "EMPLOYEE"
  previousData Json?    @map("previous_data")
  newData      Json?    @map("new_data")
  reason       String?
  ip           String?
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model VacationRequest {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  days              Int
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED, RETURNED, SIGNED, COMPLETED
  dispatchNote      String?  @map("dispatch_note")
  originalStartDate DateTime? @map("original_start_date")
  originalEndDate   DateTime? @map("original_end_date")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  employee     Employee @relation(fields: [employeeId], references: [id])
  signature    Signature?
  coverages    CoverageAssignment[]

  @@map("vacation_requests")
}

model Signature {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  vacationRequestId String   @unique @map("vacation_request_id") @db.Uuid
  hash              String   // SHA-256 of the document
  pdfUrl            String?  @map("pdf_url")
  evidenceDossier   Json?    @map("evidence_dossier")
  otpCode           String?  @map("otp_code")
  otpExpiresAt      DateTime? @map("otp_expires_at")
  zapSignDocToken   String?  @map("zapsign_doc_token")
  zapSignSignerToken String? @map("zapsign_signer_token")
  signUrl           String?  @map("sign_url")
  signedAt          DateTime? @map("signed_at")
  createdAt         DateTime @default(now())

  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  vacationRequest   VacationRequest @relation(fields: [vacationRequestId], references: [id])

  @@map("signatures")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@map("refresh_tokens")
}

model Workplace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String?
  client    String?
  minStaff  Int      @default(1) @map("min_staff")
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  positions WorkplacePosition[]
  employees Employee[]

  @@map("workplaces")
}

model WorkplacePosition {
  id            String   @id @default(uuid()) @db.Uuid
  workplaceId   String   @map("workplace_id") @db.Uuid
  role          String
  shiftPattern  String?  @map("shift_pattern")
  requiredCount Int      @default(1) @map("required_count")
  tenantId      String   @map("tenant_id") @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workplace   Workplace @relation(fields: [workplaceId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  allocations WorkplaceAllocation[]
  coverages   CoverageAssignment[]

  @@map("workplace_positions")
}

model WorkplaceAllocation {
  id                  String    @id @default(uuid()) @db.Uuid
  employeeId          String    @map("employee_id") @db.Uuid
  workplacePositionId String    @map("workplace_position_id") @db.Uuid
  startDate           DateTime  @map("start_date")
  endDate             DateTime? @map("end_date")
  status              String    @default("ACTIVE") // ACTIVE, ENDED
  tenantId            String    @map("tenant_id") @db.Uuid
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  employee          Employee          @relation(fields: [employeeId], references: [id])
  workplacePosition WorkplacePosition @relation(fields: [workplacePositionId], references: [id])
  tenant            Tenant            @relation(fields: [tenantId], references: [id])

  @@map("workplace_allocations")
}

model CoverageAssignment {
  id                    String   @id @default(uuid()) @db.Uuid
  vacationRequestId     String   @map("vacation_request_id") @db.Uuid
  replacementEmployeeId String   @map("replacement_employee_id") @db.Uuid
  workplacePositionId   String   @map("workplace_position_id") @db.Uuid
  startDate             DateTime @map("start_date")
  endDate               DateTime @map("end_date")
  type                  String   // INTERMITENTE, FERISTA
  status                String   @default("PLANNED") // PLANNED, ACTIVE, COMPLETED
  cost                  Decimal? @db.Decimal(10, 2)
  tenantId              String   @map("tenant_id") @db.Uuid
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  vacationRequest     VacationRequest   @relation(fields: [vacationRequestId], references: [id])
  replacementEmployee Employee          @relation("CoverageReplacement", fields: [replacementEmployeeId], references: [id])
  workplacePosition   WorkplacePosition @relation(fields: [workplacePositionId], references: [id])
  tenant              Tenant            @relation(fields: [tenantId], references: [id])

  @@map("coverage_assignments")
}

model Webhook {
  id        String   @id @default(uuid())
  url       String
  secret    String
  events    String[] // e.g. ["VACATION_SIGNED", "EMPLOYEE_CREATED"]
  isActive  Boolean  @default(true) @map("is_active")
  
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("webhooks")
}

model MasterKeyLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  email      String
  targetRole String?  @map("target_role")
  ip         String?
  userAgent  String?  @map("user_agent")
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("master_key_logs")
}

model SystemConfig {
  id        String   @id @default("singleton")
  masterKey String?  @map("master_key")
  masterKeyEnabled Boolean @default(false) @map("master_key_enabled")
  masterKeyUpdatedAt DateTime? @map("master_key_updated_at")
  smtpHost  String?  @map("smtp_host")
  smtpPort  Int?     @map("smtp_port")
  smtpUser  String?  @map("smtp_user")
  smtpPass  String?  @map("smtp_pass")
  smtpFrom  String?  @map("smtp_from")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_config")
}
