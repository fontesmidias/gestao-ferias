{
  "name": "gestao-ferias-monorepo",
  "version": "1.0.0",
  "description": "Multi-tenant Vacation Management System (BMM Framework)",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend-api && npm run dev",
    "dev:frontend": "cd frontend-ui && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "pm2:start": "cd backend-api && npm run build && cd .. && pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "install:all": "npm install && cd backend-api && npm install && cd ../frontend-web && npm install",
    "prisma:generate": "cd backend-api && npx prisma generate",
    "prisma:migrate": "cd backend-api && npx prisma migrate dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
